# ~/.ssh/config inside WSL. Key-based login is required: an agent cannot (and must not) type your password.
#   ssh-keygen -t ed25519 && ssh-copy-id myserver
Host myserver
    HostName 203.0.113.10
    User ubuntu
    IdentityFile ~/.ssh/id_ed25519
    ServerAliveInterval 30
    ServerAliveCountMax 4
    # Reuse one connection for extra ssh/scp calls (fast, no re-auth):
    ControlMaster auto
    ControlPath ~/.ssh/cm-%r@%h:%p
    ControlPersist 10m
